<UserControl x:Class="ICamLink.App.Controls.CameraView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <Grid Background="Black">
        <Image x:Name="Frame" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border x:Name="StatusPill" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource ScrimBrush}" CornerRadius="14" Padding="12,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Spinner" Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="StatusText" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
