<UserControl x:Class="ICamLink.App.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ICamLink.App.Controls"
             xmlns:core="clr-namespace:ICamLink.Core.Models;assembly=ICamLink.Core"
             Loaded="OnLoaded" SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <Style x:Key="BareItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LiveThumb">
            <ctl:CameraView Camera="{Binding Camera}" Quality="Sub"/>
        </DataTemplate>
        <DataTemplate x:Key="MainThumb">
            <!-- The camera already streams in HD in the main view; a second connection would waste a slot. -->
            <Grid Background="{StaticResource AccentContainerBrush}">
                <TextBlock Text="En vista principal" Foreground="{StaticResource AccentSoftBrush}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <!-- Mode 1: sidebar of thumbnails + main stream -->
        <Grid x:Name="FocusRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <!-- Standard (non-recycling) virtualization: rows scrolled away are unloaded, which frees their stream. -->
                <ListBox x:Name="Thumbs" Background="Transparent" BorderThickness="0" Padding="8,8,0,0"
                         ItemContainerStyle="{StaticResource BareItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="184" Height="104" Margin="0,0,0,8" Cursor="Hand" Background="Transparent"
                                  MouseLeftButtonUp="OnThumbClick">
                                <ctl:RoundedClip Radius="6">
                                    <ContentControl Content="{Binding}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource LiveThumb}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource MainThumb}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </ctl:RoundedClip>
                                <Border CornerRadius="6" BorderThickness="1" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Background="{StaticResource ScrimBrush}" CornerRadius="6" Padding="7,2" Margin="5"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding Camera.Name}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="1">
                <ContentControl x:Name="MainHost"/>
                <Border x:Name="MainLabel" Background="{StaticResource ScrimBrush}" CornerRadius="6" Padding="9,3" Margin="12"
                        HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                    <TextBlock x:Name="MainLabelText" FontSize="12" Foreground="White"/>
                </Border>

                <!-- Discreet floating volume control, bottom-left over the video -->
                <Border Background="{StaticResource ScrimBrush}" CornerRadius="20" Margin="12"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="4,2,14,2">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14"
                                Foreground="White" Click="OnMuteClick" ToolTip="Silenciar"/>
                        <Slider x:Name="VolumeSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                                Width="140" VerticalAlignment="Center" ValueChanged="OnVolumeChanged"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Mode 2: proportional grid (cells built in code) -->
        <Grid x:Name="GridRoot" Margin="2" Visibility="Collapsed"/>

        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="44"
                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="No hay cámaras registradas" FontSize="16" Margin="0,12,0,16" HorizontalAlignment="Center"/>
            <Button Content="Agregar cámaras" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Click="OnOpenSettings"/>
        </StackPanel>

        <!-- Discreet floating top-right panel -->
        <Border Background="{StaticResource ScrimBrush}" CornerRadius="20" Margin="12"
                HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ModeButton" Style="{StaticResource IconButton}" Foreground="White" Click="OnToggleMode"/>
                <Button Content="&#xE713;" Style="{StaticResource IconButton}" Foreground="White"
                        Click="OnOpenSettings" ToolTip="Configuración"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
