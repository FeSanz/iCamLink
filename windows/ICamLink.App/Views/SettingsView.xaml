<UserControl x:Class="ICamLink.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CameraRow" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="0">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FoundRow" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.42*" MinWidth="320"/>
            <ColumnDefinition Width="0.58*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: header, actions and registered cameras -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="&#xE72B;" Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Volver (Esc)"/>
                    <TextBlock Text="Configuración" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Grid.Row="1" Style="{StaticResource AccentButton}" Click="OnScan">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="#11151F" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Escanear red local" Foreground="#11151F"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="2" Style="{StaticResource OutlineButton}" Margin="0,8,0,0" Click="OnAddManual">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Agregar manualmente"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CamerasTitle" Grid.Row="3" Style="{StaticResource SectionTitle}" Margin="0,18,0,4"/>
                <ListBox x:Name="CameraList" Grid.Row="4" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CameraRow}" AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                         DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="4,0,12,0" Cursor="SizeAll" ToolTip="Arrastrar para reordenar"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                                        <Run Text="{Binding Host, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#xE70F;" Style="{StaticResource IconButton}" Foreground="{StaticResource MutedBrush}"
                                        Click="OnEditCamera" ToolTip="Editar"/>
                                <Button Grid.Column="3" Content="&#xE74D;" Style="{StaticResource IconButton}" Foreground="{StaticResource DangerBrush}"
                                        Click="OnDeleteCamera" ToolTip="Eliminar"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right: scan results / add-edit form -->
        <Grid Grid.Column="1" Margin="20">
            <TextBlock x:Name="IdleHint" Text="Escanea la red o agrega una cámara manualmente."
                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- A. Network scan -->
            <Grid x:Name="ScanPane" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="FoundTitle" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    <Button x:Name="ScanToggle" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Click="OnScanToggle"/>
                </Grid>
                <ProgressBar x:Name="ScanBar" Grid.Row="1" Style="{StaticResource ThinProgress}" Maximum="1" Margin="0,2,0,0"/>
                <TextBlock x:Name="ScanErrorText" Grid.Row="2" Foreground="{StaticResource DangerBrush}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Grid Grid.Row="3" Margin="0,4,0,0">
                    <TextBlock x:Name="NoneFound" Text="No se encontraron cámaras." Foreground="{StaticResource MutedBrush}"
                               Margin="0,12,0,0" VerticalAlignment="Top"/>
                    <ListBox x:Name="FoundList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource FoundRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" Background="Transparent" MouseLeftButtonUp="OnFoundRowClick">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource CheckMark}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              IsEnabled="{Binding CanSelect}" Margin="4,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Camera.Host}" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="12" Margin="8,0,6,0" VerticalAlignment="Center"
                                               Foreground="{Binding BadgeBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Usuario RTSP" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ScanUser" Style="{StaticResource FieldBox}" TextChanged="OnScanCredsChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Contraseña RTSP" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ScanPass" Style="{StaticResource FieldPassword}" PasswordChanged="OnScanCredsChanged"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="ScanTest" Content="Probar" Style="{StaticResource OutlineButton}" Click="OnScanTest"/>
                    <Button x:Name="ScanAdd" Style="{StaticResource AccentButton}" Margin="8,0,12,0" Click="OnScanAdd"/>
                    <TextBlock x:Name="ScanTestResult" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
                </StackPanel>
            </Grid>

            <!-- B. Manual add / edit -->
            <ScrollViewer x:Name="EditorPane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <TextBlock Text="Nombre personalizado" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" TextChanged="OnEditorChanged"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Dirección IP" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="HostBox" Style="{StaticResource FieldBox}" TextChanged="OnEditorChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Puerto RTSP" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PortBox" Style="{StaticResource FieldBox}" Text="554" TextChanged="OnEditorChanged"
                                     PreviewTextInput="OnPortInput"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Usuario RTSP" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <TextBox x:Name="UserBox" Style="{StaticResource FieldBox}" TextChanged="OnEditorChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Contraseña RTSP" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="PassBox" Style="{StaticResource FieldPassword}" PasswordChanged="OnEditorChanged"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="EditorTest" Content="Probar conexión" Style="{StaticResource OutlineButton}" Click="OnEditorTest"/>
                        <Button x:Name="EditorSave" Content="Guardar" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="OnEditorSave"/>
                        <Button Content="Cancelar" Style="{StaticResource TextButton}" Margin="4,0,0,0" Click="OnEditorCancel"/>
                    </StackPanel>
                    <TextBlock x:Name="EditorResult" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
