<Window x:Class="ICamLink.App.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:ICamLink.App.Controls"
        Title="iCamLink" Width="400" Height="225" MinWidth="240" MinHeight="135"
        WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Icon="pack://application:,,,/Assets/app.png" Background="Black"
        SourceInitialized="OnSourceInitialized" Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <!-- No caption: the window is dragged from its body and resized from its 8px edge/corner border. -->
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="OnDrag">
            <ctl:CameraView x:Name="Video" Quality="Main" IsHitTestVisible="False"/>

            <Border Background="{StaticResource ScrimBrush}" CornerRadius="6" Padding="7,2" Margin="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <TextBlock x:Name="NameText" FontSize="11" Foreground="White"/>
            </Border>

            <!-- Controls appear while the pointer is over the window, like a video player's. -->
            <Border VerticalAlignment="Bottom" Margin="12,0,12,12" Padding="4,2,10,2"
                    Background="{StaticResource ScrimBrush}" CornerRadius="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13"
                            Foreground="White" Click="OnMute" ToolTip="Silenciar"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                            VerticalAlignment="Center" Margin="2,0,8,0" ValueChanged="OnVolumeSlider"/>
                    <Button Grid.Column="2" Content="&#xE740;" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Foreground="White" Click="OnExpand" ToolTip="Abrir iCamLink"/>
                    <Button Grid.Column="3" Content="&#xE711;" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                            Foreground="White" Click="OnClose" ToolTip="Cerrar miniatura"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
